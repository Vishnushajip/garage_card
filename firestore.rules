rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isGarageMember(garageId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/garages/$(garageId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      match /deviceTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update: if isOwner(userId);
        allow create: if isAuthenticated();
      }
    }

    match /garages/{garageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isGarageMember(garageId);

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isGarageMember(garageId);
      }

      match /customers/{customerId} {
        allow read, write: if isGarageMember(garageId);
      }

      match /vehicles/{vehicleId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);
      }

      match /serviceJobs/{jobId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);

        match /history/{historyId} {
          allow read: if isGarageMember(garageId) || (isAuthenticated() && get(/databases/$(database)/documents/garages/$(garageId)/serviceJobs/$(jobId)).data.customerId == request.auth.uid);
          allow write: if isGarageMember(garageId);
        }
      }

      match /inspections/{inspectionId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && get(/databases/$(database)/documents/garages/$(garageId)/serviceJobs/$(resource.data.jobId)).data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);
      }

      match /serviceCatalog/{serviceId} {
        allow read: if isAuthenticated();
        allow write: if isGarageMember(garageId);
      }

      match /estimates/{estimateId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);
        allow update: if isAuthenticated() && resource.data.customerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason', 'approvedAt']);
      }

      match /invoices/{invoiceId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);
      }

      match /payments/{paymentId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);
      }

      match /appointments/{appointmentId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow create: if isAuthenticated();
        allow update, delete: if isGarageMember(garageId);
      }

      match /serviceRequests/{requestId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow create: if isAuthenticated();
        allow update, delete: if isGarageMember(garageId);
      }

      match /reminders/{reminderId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);
      }

      match /subscriptions/{subId} {
        allow read: if isGarageMember(garageId);
        allow write: if false;
      }

      match /settings/{settingsId} {
        allow read: if isGarageMember(garageId);
        allow write: if isGarageMember(garageId);
      }
    }
  }
}
