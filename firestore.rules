rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Models
    // ===============================================================
    //
    // garages/{garageId}
    //   - Public discovery document for garages and workshops.
    //   - Subcollections: services, serviceCatalog, reviews, customers,
    //     vehicles, serviceJobs, jobs, inspections, estimates, invoices,
    //     payments, appointments, serviceRequests, reminders, inventory,
    //     parts, members, mechanics, settings, subscriptions, notifications.
    //
    // users/{userId}
    //   - User profile (customer or merchant) managed with Firebase Auth.
    //   - Subcollections: notifications, vehicles, serviceReminders,
    //     deviceTokens, fcmTokens.
    //
    // conversations/{conversationId}
    //   - In-app chat between customers and garages.
    //   - Subcollection: messages.
    //
    // supportTickets/{ticketId}
    //   - Support and dispute tickets for customers and merchants.
    //   - Subcollections: messages, history.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // User Documents & Subcollections
    // ===============================================================

    match /users/{userId} {
      // Authenticated users can read user profiles (needed for customer/merchant interactions)
      allow read: if isAuthenticated();
      // Users can write/update their own profile
      allow write: if isOwner(userId) || isAuthenticated();

      match /notifications/{notificationId} {
        // Owner reads & updates notifications; any authenticated user/system can create a notification
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }

      match /vehicles/{vehicleId} {
        allow read, write: if isAuthenticated();
      }

      match /serviceReminders/{reminderId} {
        allow read, write: if isAuthenticated();
      }

      match /deviceTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // Garages & Subcollections
    // ===============================================================

    match /garages/{garageId} {
      // Public read so customers can search, discover, and view garages
      allow read: if true;
      // Authenticated users can register or update garage data
      allow write: if isAuthenticated();

      // Public discovery subcollections
      match /services/{serviceId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /serviceCatalog/{serviceId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      match /mechanics/{mechanicId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      // Operational subcollections (require authentication)
      match /customers/{customerId} {
        allow read, write: if isAuthenticated();
      }

      match /vehicles/{vehicleId} {
        allow read, write: if isAuthenticated();
      }

      match /serviceJobs/{jobId} {
        allow read, write: if isAuthenticated();

        match /history/{historyId} {
          allow read, write: if isAuthenticated();
        }
      }

      match /jobs/{jobId} {
        allow read, write: if isAuthenticated();

        match /history/{historyId} {
          allow read, write: if isAuthenticated();
        }
      }

      match /inspections/{inspectionId} {
        allow read, write: if isAuthenticated();
      }

      match /estimates/{estimateId} {
        allow read, write: if isAuthenticated();
      }

      match /invoices/{invoiceId} {
        allow read, write: if isAuthenticated();
      }

      match /payments/{paymentId} {
        allow read, write: if isAuthenticated();
      }

      match /appointments/{appointmentId} {
        allow read, write: if isAuthenticated();
      }

      match /serviceRequests/{requestId} {
        allow read, write: if isAuthenticated();
      }

      match /reminders/{reminderId} {
        allow read, write: if isAuthenticated();
      }

      match /inventory/{itemId} {
        allow read, write: if isAuthenticated();
      }

      match /parts/{partId} {
        allow read, write: if isAuthenticated();
      }

      match /members/{memberId} {
        allow read, write: if isAuthenticated();
      }

      match /settings/{settingsId} {
        allow read, write: if isAuthenticated();
      }

      match /subscriptions/{subId} {
        allow read, write: if isAuthenticated();
      }

      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ===============================================================
    // Conversations & Messages
    // ===============================================================

    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ===============================================================
    // Support Tickets & History
    // ===============================================================

    match /supportTickets/{ticketId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }

      match /history/{historyId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ===============================================================
    // Standalone Reviews & Event Processing
    // ===============================================================

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /processedEvents/{eventId} {
      allow read, write: if false;
    }

    // ===============================================================
    // Collection Group Queries
    // ===============================================================
    // Ensures Flutter collectionGroup queries do not trigger permission-denied

    match /{path=**}/customers/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/invoices/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/payments/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/serviceJobs/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/jobs/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/appointments/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/estimates/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/reminders/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/vehicles/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/history/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/supportTickets/{id} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/mechanics/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
