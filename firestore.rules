rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isGarageMember(garageId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/garages/$(garageId)/members/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/garages/$(garageId)) &&
         get(/databases/$(database)/documents/garages/$(garageId)).data.ownerUid == request.auth.uid)
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /deviceTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }
    }

    match /processedEvents/{eventId} {
      allow read, write: if isAuthenticated();
    }

    match /garages/{garageId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isGarageMember(garageId);

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isGarageMember(garageId);
      }

      match /customers/{customerId} {
        allow read, write: if isGarageMember(garageId);
      }

      match /vehicles/{vehicleId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);
      }

      match /serviceJobs/{jobId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);

        match /history/{historyId} {
          allow read: if isAuthenticated();
          allow write: if isGarageMember(garageId);
        }
      }

      match /inspections/{inspectionId} {
        allow read: if isAuthenticated();
        allow write: if isGarageMember(garageId);
      }

      match /serviceCatalog/{serviceId} {
        allow read: if true;
        allow write: if isGarageMember(garageId);
      }

      match /estimates/{estimateId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);
        allow update: if isAuthenticated() && resource.data.customerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason', 'approvedAt']);
      }

      match /invoices/{invoiceId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);
      }

      match /payments/{paymentId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId);
      }

      match /appointments/{appointmentId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow create: if isAuthenticated();
        allow update, delete: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      }

      match /serviceRequests/{requestId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow create: if isAuthenticated();
        allow update, delete: if isGarageMember(garageId);
      }

      match /reminders/{reminderId} {
        allow read: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
        allow write: if isGarageMember(garageId) || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isGarageMember(garageId);
        allow create: if isAuthenticated();
      }

      match /subscriptions/{subId} {
        allow read: if isGarageMember(garageId);
        allow write: if false;
      }

      match /settings/{settingsId} {
        allow read: if isGarageMember(garageId);
        allow write: if isGarageMember(garageId);
      }
    }

    match /{path=**}/serviceJobs/{jobId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isGarageMember(resource.data.garageId)
      );
      allow write: if isAuthenticated() && isGarageMember(resource.data.garageId);
    }

    match /{path=**}/vehicles/{vehicleId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isGarageMember(resource.data.garageId)
      );
      allow write: if isAuthenticated() && isGarageMember(resource.data.garageId);
    }

    match /{path=**}/estimates/{estimateId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isGarageMember(resource.data.garageId)
      );
      allow write: if isAuthenticated() && isGarageMember(resource.data.garageId);
    }

    match /{path=**}/invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isGarageMember(resource.data.garageId)
      );
      allow write: if isAuthenticated() && isGarageMember(resource.data.garageId);
    }

    match /{path=**}/reminders/{reminderId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isGarageMember(resource.data.garageId)
      );
      allow write: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isGarageMember(resource.data.garageId)
      );
    }

    match /{path=**}/appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        isGarageMember(resource.data.garageId)
      );
      allow write: if isAuthenticated() && (
        request.resource.data.customerId == request.auth.uid ||
        isGarageMember(resource.data.garageId)
      );
    }

    match /{path=**}/history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
