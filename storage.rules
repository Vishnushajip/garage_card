rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /garages/{garageId}/logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /garages/{garageId}/inspections/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /garages/{garageId}/documents/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
